{
  "name": "@lenspack/sql",
  "version": "0.1.0",
  "description": "Compiles lenspack's closed query IR against a pack into parameterised SQL, and runs it read-only through drivers for Postgres, DuckDB, SQLite, MySQL/MariaDB and ClickHouse.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./pg": { "types": "./dist/executors/pg.d.ts", "import": "./dist/executors/pg.js" },
    "./duckdb": { "types": "./dist/executors/duckdb.d.ts", "import": "./dist/executors/duckdb.js" },
    "./mysql": { "types": "./dist/executors/mysql.d.ts", "import": "./dist/executors/mysql.js" },
    "./sqlite": { "types": "./dist/executors/sqlite.d.ts", "import": "./dist/executors/sqlite.js" },
    "./clickhouse": { "types": "./dist/executors/clickhouse.d.ts", "import": "./dist/executors/clickhouse.js" }
  },
  "files": ["dist"],
  "scripts": { "build": "tsup src/index.ts src/executors/pg.ts src/executors/duckdb.ts src/executors/mysql.ts src/executors/sqlite.ts src/executors/clickhouse.ts --format esm --dts --clean --tsconfig tsconfig.build.json" },
  "dependencies": { "@lenspack/core": "workspace:*", "@lenspack/engine": "workspace:*", "@lenspack/spec": "workspace:*" },
  "peerDependencies": { "@duckdb/node-api": "*", "better-sqlite3": ">=11", "mysql2": ">=3.9", "pg": ">=8.11.0" },
  "peerDependenciesMeta": { "@duckdb/node-api": { "optional": true }, "better-sqlite3": { "optional": true }, "mysql2": { "optional": true }, "pg": { "optional": true } },
  "devDependencies": { "@duckdb/node-api": "^1.4.0-r.1", "@types/better-sqlite3": "^7.6.13", "@types/pg": "^8.11.10", "better-sqlite3": "^12.11.1", "mysql2": "^3.24.5", "pg": "^8.13.1" },
  "repository": { "type": "git", "url": "https://github.com/theflywheel/lenspack", "directory": "packages/sql" }
}
