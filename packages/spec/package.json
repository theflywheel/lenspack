{
  "name": "@lenspack/spec",
  "version": "0.1.0",
  "description": "Pack loader for lenspack: parse and validate a metric catalogue (entities, dimensions, measures, joins) from YAML or JSON.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": { "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json" },
  "dependencies": { "@lenspack/core": "workspace:*", "yaml": "^2.6.1", "zod": "^3.25.76" },
  "repository": { "type": "git", "url": "https://github.com/theflywheel/lenspack", "directory": "packages/spec" }
}
