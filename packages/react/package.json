{
  "name": "@lenspack/react",
  "version": "0.1.0",
  "description": "React renderer for lenspack boards: grid, widgets, filter bar, version history \u2014 and a chart adapter seam with svg, recharts, echarts and shadcn adapters.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./adapters/svg": {
      "types": "./dist/adapters/svg.d.ts",
      "import": "./dist/adapters/svg.js"
    },
    "./adapters/recharts": {
      "types": "./dist/adapters/recharts.d.ts",
      "import": "./dist/adapters/recharts.js"
    },
    "./adapters/echarts": {
      "types": "./dist/adapters/echarts.d.ts",
      "import": "./dist/adapters/echarts.js"
    },
    "./adapters/shadcn": {
      "types": "./dist/adapters/shadcn.d.ts",
      "import": "./dist/adapters/shadcn.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup src/index.tsx src/adapters/svg.tsx src/adapters/recharts.tsx src/adapters/echarts.tsx src/adapters/shadcn.tsx --format esm --dts --clean --tsconfig tsconfig.build.json && cp src/styles.css dist/styles.css"
  },
  "dependencies": {
    "@lenspack/core": "workspace:*",
    "react-grid-layout": "^1.5.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "recharts": ">=3",
    "echarts": ">=5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-grid-layout": "^1.3.5",
    "echarts": "^6.1.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theflywheel/lenspack",
    "directory": "packages/react"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "echarts": {
      "optional": true
    }
  }
}
