{
  "name": "@lenspack/engine",
  "version": "0.1.0",
  "description": "Resolves lenspack's query IR against a pack and runs it through a Connector: the backend-neutral half of lenspack.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": { "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json" },
  "dependencies": { "@lenspack/core": "workspace:*", "@lenspack/spec": "workspace:*" },
  "repository": { "type": "git", "url": "https://github.com/theflywheel/lenspack", "directory": "packages/engine" }
}
