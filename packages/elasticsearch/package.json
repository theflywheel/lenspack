{
  "name": "@lenspack/elasticsearch",
  "version": "0.1.0",
  "description": "An Elasticsearch / OpenSearch connector for lenspack: compiles the query IR to aggregations over plain HTTP. ES 6.x–8.x and OpenSearch.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": { "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json" },
  "dependencies": { "@lenspack/core": "workspace:*", "@lenspack/engine": "workspace:*", "@lenspack/spec": "workspace:*" },
  "repository": { "type": "git", "url": "https://github.com/theflywheel/lenspack", "directory": "packages/elasticsearch" }
}
