{
  "name": "@lenspack/policy",
  "version": "0.1.0",
  "description": "Access policy for lenspack: from who is asking, the pack and the deployment's rules, the row scope and the keys kept from them. Pure; the engine enforces it.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": { "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json" },
  "dependencies": { "@lenspack/core": "workspace:*", "@lenspack/pack": "workspace:*", "zod": "^3.25.76" },
  "repository": { "type": "git", "url": "https://github.com/theflywheel/lenspack", "directory": "packages/kernel/policy" }
}
