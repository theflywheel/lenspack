    {
      "op": "add_widget",
      "id": "s_users",
      "placement": {
        "place": "bottom",
        "width": "full",
        "height": 2
      },
      "widget": {
        "kind": "text",
        "title": "Users",
        "body": "Is the pilot reaching people, and is use growing? Which roles and countries use it?"
      }
    },
    {
      "op": "add_widget",
      "id": "users_7d",
      "placement": {
        "place": "bottom",
        "width": "quarter",
        "height": 3
      },
      "widget": {
        "kind": "kpi",
        "title": "Active users, 7 days",
        "query": {
          "kind": "value",
          "measure": "people",
          "time": {
            "last": "7d"
          }
        }
      }
    },
