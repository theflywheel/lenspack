{
  "title": "Campaign delivery",
  "ops": [
    { "op": "add_widget", "id": "tasks_30d", "placement": { "place": "top", "width": "quarter", "height": 3 },
      "widget": { "kind": "kpi", "title": "Visits, last 30 days", "query": { "kind": "value", "measure": "tasks", "compare": "previous_period", "time": { "last": "30d" } } } },
    { "op": "add_widget", "id": "success", "placement": { "place": "top", "width": "quarter", "height": 3 },
      "widget": { "kind": "kpi", "title": "Administration success", "query": { "kind": "value", "measure": "success_rate" } } },
    { "op": "add_widget", "id": "delivered", "placement": { "place": "top", "width": "quarter", "height": 3 },
      "widget": { "kind": "kpi", "title": "Product lines delivered", "query": { "kind": "value", "measure": "delivered_rate" } } },
    { "op": "add_widget", "id": "households", "placement": { "place": "top", "width": "quarter", "height": 3 },
      "widget": { "kind": "kpi", "title": "Households registered", "query": { "kind": "value", "measure": "households" } } },
    { "op": "add_widget", "id": "weekly", "placement": { "place": "bottom", "width": "full", "height": 7 },
      "widget": { "kind": "chart", "chart": "line", "title": "Weekly visits by campaign", "query": { "kind": "series", "measure": "tasks", "grain": "week", "by": "campaign" } } },
    { "op": "add_widget", "id": "success_by_locality", "placement": { "place": "bottom", "width": "half", "height": 8 },
      "widget": { "kind": "chart", "chart": "bar", "title": "Success rate by locality (lowest first)", "query": { "kind": "breakdown", "dimension": "locality", "measure": "success_rate", "limit": 12, "sort": "asc" } } },
    { "op": "add_widget", "id": "reasons", "placement": { "place": "bottom", "width": "half", "height": 8 },
      "widget": { "kind": "chart", "chart": "bar", "title": "Why lines were not delivered", "query": { "kind": "breakdown", "dimension": "non_delivery_reason", "measure": "undelivered", "limit": 6 } } },
    { "op": "add_filter", "filter": { "id": "filter_campaign", "type": "select", "label": "Campaign", "field": "campaign", "applies": ["*"] } }
  ]
}
