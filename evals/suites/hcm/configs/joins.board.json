{
 "version": 2,
 "pack": "hcm_clickhouse",
 "packVersion": 1,
 "title": "Kebbi nOPV2 campaign: national view (ClickHouse dev)",
 "grid": {
  "cols": 12,
  "rowHeight": 40,
  "density": "comfortable",
  "fill": true
 },
 "layout": [
