{
 "version": 2,
 "pack": "hcm_clickhouse",
 "packVersion": 1,
 "title": "nOPV2 field test: national view (ClickHouse)",
 "grid": {
  "cols": 12,
  "rowHeight": 40,
  "density": "comfortable",
  "fill": true
 },
 "layout": [
  {
   "i": "c43",
   "x": 0,
   "y": 0,
   "w": 6,
   "h": 7
  },
  {
   "i": "c44",
   "x": 6,
   "y": 0,
   "w": 6,
