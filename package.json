{
  "name": "lenspack-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*/*' run build",
    "test": "vitest run",
    "test:pg": "LENSPACK_PG_URL=${LENSPACK_PG_URL:-postgres://localhost:5432/lenspack_test} vitest run",
    "test:access": "vitest run --config vitest.access.config.ts",
    "typecheck": "pnpm -r --filter './packages/*/*' exec tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.json",
    "lint:domain": "node scripts/zero-domain-grep.mjs",
    "lint:docs": "tsx scripts/config-keys.ts --check",
    "smoke:dist": "node scripts/dist-smoke.mjs",
    "seed": "tsx scripts/seed.ts",
    "docs:keys": "tsx scripts/config-keys.ts",
    "check": "pnpm typecheck && pnpm lint:domain && pnpm lint:docs && pnpm test",
    "demo": "node scripts/demo.mjs",
    "eval": "tsx evals/run.ts",
    "eval:suite": "tsx evals/suite-run.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@lenspack/superset": "workspace:*",
    "@types/node": "^22.10.0",
    "ai": "^7.0.109",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1",
    "zod": "^3.25.76"
  }
}
