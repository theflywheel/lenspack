{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@lenspack/core": ["packages/kernel/core/src/index.ts"],
      "@lenspack/pack": ["packages/kernel/pack/src/index.ts"],
      "@lenspack/policy": ["packages/kernel/policy/src/index.ts"],
      "@lenspack/engine": ["packages/kernel/engine/src/index.ts"],
      "@lenspack/elasticsearch": ["packages/sources/elasticsearch/src/index.ts"],
      "@lenspack/superset": ["packages/hosts/superset/src/index.ts"],
      "@lenspack/superset/server": ["packages/hosts/superset/src/server.ts"],
      "@lenspack/dss": ["packages/packs/dss/src/index.ts"],
      "@lenspack/ccrs": ["packages/packs/ccrs/src/index.ts"],
      "@lenspack/serve": ["packages/hosts/serve/src/index.ts"],
      "@lenspack/sql": ["packages/sources/sql/src/index.ts"],
      "@lenspack/sql/pg": ["packages/sources/sql/src/executors/pg.ts"],
      "@lenspack/sql/duckdb": ["packages/sources/sql/src/executors/duckdb.ts"],
      "@lenspack/sql/mysql": ["packages/sources/sql/src/executors/mysql.ts"],
      "@lenspack/sql/sqlite": ["packages/sources/sql/src/executors/sqlite.ts"],
      "@lenspack/sql/clickhouse": ["packages/sources/sql/src/executors/clickhouse.ts"],
      "@lenspack/agent": ["packages/kernel/agent/src/index.ts"],
      "@lenspack/mcp": ["packages/hosts/mcp/src/index.ts"],
      "@lenspack/react": ["packages/hosts/react/src/index.tsx"],
      "@lenspack/react/adapters/*": ["packages/hosts/react/src/adapters/*.tsx"]
    }
  }
}
